{
  "_doc": [
    "自定义去广告规则格式（本字段仅为说明，可删除，不影响功能）：",
    "· playlistRules: 全局分片规则 [{type:\"regex\"|\"keyword\", pattern:\"...\"}]，匹配每个媒体分片的 URL",
    "· hostRules: 按域名生效 [{host:\"...\", regex:[...], keywords:[...]}]，仅当播放列表来自该域名时匹配",
    "· blockedDomains: [\"域名\", ...] 命中即拦截整个请求（含子域名）",
    "· blockedUrlPatterns: [\"正则\", ...] 按完整请求 URL 拦截",
    "· heuristics: {enabled, minAdBlockSegments, maxAdBlockSegments, keyNoneSwitch, urlPrefixAnomaly, mirrorReuse, durationWindows}",
    "  SCTE-35 / CUE-OUT / CUE-IN 广告标记始终生效；urlPrefixAnomaly/mirrorReuse/durationWindows 默认关闭（过于激进）",
    "导入也接受：TVBox XC.json、anti-AD 域名列表、m3u8-proxy 规则"
  ],
  "version": 2,
  "playlistRules": [
    {"type": "regex", "pattern": "/ad/"},
    {"type": "regex", "pattern": "/ads/"},
    {"type": "regex", "pattern": "_ad_"},
    {"type": "regex", "pattern": "_ads_"},
    {"type": "regex", "pattern": "/adjump"},
    {"type": "keyword", "pattern": "sponsor"},
    {"type": "keyword", "pattern": "promo"},
    {"type": "keyword", "pattern": "splash"},
    {"type": "keyword", "pattern": "vip_ad"},
    {"type": "keyword", "pattern": "advert"},
    {"type": "keyword", "pattern": "advertisement"},
    {"type": "keyword", "pattern": "interstitial"},
    {"type": "keyword", "pattern": "redtraffic"},
    {"type": "keyword", "pattern": "preroll"},
    {"type": "keyword", "pattern": "midroll"}
  ],
  "hostRules": [],
  "blockedDomains": [
    "doubleclick.net",
    "googlesyndication.com",
    "adservice.google.com",
    "googleadservices.com",
    "googletagmanager.com",
    "googletagservices.com",
    "google-analytics.com",
    "scorecardresearch.com",
    "moatads.com",
    "adsrvr.org",
    "adnxs.com",
    "rubiconproject.com",
    "pubmatic.com",
    "openx.net",
    "criteo.com",
    "criteo.net",
    "taboola.com",
    "outbrain.com",
    "adform.net",
    "advertising.com",
    "adroll.com",
    "casalemedia.com",
    "quantserve.com",
    "chartbeat.com",
    "amazon-adsystem.com",
    "adcolony.com",
    "vungle.com",
    "applovin.com",
    "inmobi.com",
    "smaato.net",
    "zedo.com"
  ],
  "blockedUrlPatterns": [],
  "heuristics": {
    "enabled": true,
    "minAdBlockDurationSec": 4,
    "maxAdBlockDurationSec": 30,
    "minAdBlockSegments": 2,
    "maxAdBlockSegments": 8,
    "urlPrefixAnomaly": false,
    "keyNoneSwitch": true,
    "mirrorReuse": false,
    "durationWindows": false
  }
}
